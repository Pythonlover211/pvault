<?xml version="1.0" encoding="utf-8"?>
<!--
  自适应图标的前景层。画布 108dp，但外围会被启动器按自身形状裁掉，
  安全区只有中心约 72dp —— 所以内容必须缩在这个范围内。

  下面这组坐标是从 icons/icon.svg 等比换算来的（原图 192 画布，内容以 (96,96)
  为中心、跨度 102），换算到 108dp 画布的中心 (54,54)、缩放 0.6，跨度变成 61.2dp，
  任何遮罩形状下都不会被切到。线宽 13 同样乘 0.6 得 7.8。
  改图标时记得两边一起改，不要只改 SVG。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- ¥ 的上半 V 形 -->
    <path
        android:pathData="M31.2,27.6 L54,54 L76.8,27.6"
        android:strokeColor="#ffffff"
        android:strokeWidth="7.8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- 竖笔 -->
    <path
        android:pathData="M54,54 L54,81.6"
        android:strokeColor="#ffffff"
        android:strokeWidth="7.8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- 两道横杠 -->
    <path
        android:pathData="M32.4,58.8 L75.6,58.8"
        android:strokeColor="#ffffff"
        android:strokeWidth="7.8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M32.4,69.6 L75.6,69.6"
        android:strokeColor="#ffffff"
        android:strokeWidth="7.8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
